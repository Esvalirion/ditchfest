PORT=3000
USER_AGENT=ditchfest / your@email.com

# PostgreSQL — can share the same Postgres container as tm-api/cotd on the
# VPS (see COTD_MIGRATION_PLAN.md §2); this server just needs its own
# database name.
DATABASE_URL=postgresql://user:password@localhost:5432/ditchfest_db

# TM OAuth app (api.trackmania.com -> developer -> apps). This is the
# "Login with Ubisoft" flow — same provider COTD uses for "Login with TM",
# and also used to resolve display names (services/names.js), same as the
# real tm-votes source. No separate redirect-URI var: it's derived from the
# request per-call (see routes/auth.js) — just register every domain this
# app is served from (localhost, df.esvalirion.tech, ditchfest.su, ...) as
# a Redirect URI on the OAuth app.
TM_CLIENT_ID=your_client_id
TM_CLIENT_SECRET=your_client_secret
TM_FRONTEND_URL=http://localhost:5173

# Sign/verify session JWTs — any long random string (openssl rand -hex 32).
JWT_SECRET=change-me

# Single accountId — always admin, can't be removed via /api/admins.
ROOT_ADMIN_ID=

# Set by CI/CD, do not edit manually
GHCR_IMAGE=ghcr.io/your-user/ditchfest-signs:latest
