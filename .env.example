# Consumed by docker-compose.yml (env_file: .env) on the VPS — same
# variables server/.env.example documents for local dev, copied here
# because Compose reads .env relative to the compose file, not server/.
# In production TM_FRONTEND_URL should be the site's real origin
# (https://df.esvalirion.tech, later https://ditchfest.su — see
# COTD_MIGRATION_PLAN.md Фаза 7).

PORT=3000
USER_AGENT=ditchfest / your@email.com

# PostgreSQL — shares the same Postgres container as tm-api/cotd on the VPS
# (see COTD_MIGRATION_PLAN.md §2); this server just needs its own database.
DATABASE_URL=postgresql://tmadmin:changeme@tm-postgres:5432/ditchfest_db

# TM OAuth app (api.trackmania.com -> developer -> apps) — "Login with
# Ubisoft" and display-name resolution (server/services/names.js). No
# separate redirect-URI var: derived from the request per-call, just
# register every domain this app is served from as a Redirect URI.
TM_CLIENT_ID=your_client_id
TM_CLIENT_SECRET=your_client_secret
TM_FRONTEND_URL=https://df.esvalirion.tech

# Sign/verify session JWTs — any long random string (openssl rand -hex 32).
JWT_SECRET=change-me

# Single accountId — always admin, can't be removed via /api/admins.
ROOT_ADMIN_ID=

# Set by CI/CD, do not edit manually
GHCR_IMAGE=ghcr.io/your-user/ditchfest-signs:latest
